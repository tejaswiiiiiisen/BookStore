    <!-- ============================================================== -->
    <!-- CLIENT-SIDE SEARCH & FAST FILTER SCRIPT                        -->
    <!-- ============================================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('hero-search-input');
            const categoryPills = document.querySelectorAll('.category-pill');
            const bookCards = document.querySelectorAll('.book-card');
            const noResults = document.getElementById('no-search-results');
            const clearBtn = document.getElementById('clear-search-btn');

            let currentCategory = 'all';
            let searchQuery = '';

            function filterBooks() {
                let visibleCount = 0;

                bookCards.forEach(card => {
                    const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
                    const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
                    const cardAuthor = (card.getAttribute('data-author') || '').toLowerCase();

                    const matchesCategory = currentCategory === 'all' || cardCat.includes(currentCategory);
                    const matchesSearch = !searchQuery || 
                                          cardTitle.includes(searchQuery) || 
                                          cardAuthor.includes(searchQuery) || 
                                          cardCat.includes(searchQuery);

                    if (matchesCategory && matchesSearch) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResults) {
                    if (visibleCount === 0) {
                        noResults.classList.remove('hidden');
                    } else {
                        noResults.classList.add('hidden');
                    }
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    searchQuery = e.target.value.trim().toLowerCase();
                    filterBooks();
                });
            }

            categoryPills.forEach(pill => {
                pill.addEventListener('click', () => {
                    categoryPills.forEach(p => {
                        p.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');
                        p.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
                    });
                    pill.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
                    pill.classList.add('bg-indigo-600', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');

                    currentCategory = pill.getAttribute('data-filter') || 'all';
                    filterBooks();
                });
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    if (searchInput) searchInput.value = '';
                    searchQuery = '';
                    currentCategory = 'all';
                    categoryPills.forEach((p, idx) => {
                        if (idx === 0) {
                            p.classList.remove('bg-white', 'text-gray-700', 'border');
                            p.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
                        } else {
                            p.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
                            p.classList.add('bg-white', 'text-gray-700', 'border');
                        }
                    });
                    filterBooks();
                });
            }

            // ==============================================================
            // HERO FEATURED SHOWCASE SLIDING CAROUSEL (ONE BY ONE)
            // ==============================================================
            const heroTrack = document.getElementById('hero-slider-track');
            const heroViewport = document.getElementById('hero-slider-viewport');
            const heroDots = document.querySelectorAll('.hero-slider-dot');
            const prevHeroBtn = document.getElementById('hero-slider-prev');
            const nextHeroBtn = document.getElementById('hero-slider-next');
            const heroContainer = document.getElementById('hero-showcase-container');

            if (heroTrack) {
                const initialSlides = Array.from(heroTrack.querySelectorAll('.hero-slide-item'));
                const totalRealSlides = initialSlides.length;

                if (totalRealSlides > 1) {
                    // Clone first and last slide for smooth continuous infinite horizontal sliding
                    const firstClone = initialSlides[0].cloneNode(true);
                    firstClone.classList.add('hero-slide-clone');
                    const lastClone = initialSlides[totalRealSlides - 1].cloneNode(true);
                    lastClone.classList.add('hero-slide-clone');

                    heroTrack.appendChild(firstClone);
                    heroTrack.insertBefore(lastClone, initialSlides[0]);

                    let currentIndex = 1; // starts at real slide 1
                    let isMoving = false;
                    let autoSlideTimer = null;

                    // Set initial position immediately (Slide 1)
                    heroTrack.style.transition = 'none';
                    heroTrack.style.transform = `translateX(-${currentIndex * 100}%)`;

                    function updateDots() {
                        let dotIdx = currentIndex - 1;
                        if (dotIdx < 0) dotIdx = totalRealSlides - 1;
                        if (dotIdx >= totalRealSlides) dotIdx = 0;

                        heroDots.forEach((dot, i) => {
                            if (i === dotIdx) {
                                dot.classList.remove('w-1.5', 'h-1.5', 'bg-white/30');
                                dot.classList.add('w-5', 'h-1.5', 'bg-amber-400');
                            } else {
                                dot.classList.remove('w-5', 'bg-amber-400');
                                dot.classList.add('w-1.5', 'h-1.5', 'bg-white/30');
                            }
                        });
                    }

                    function slideTo(index, speed = '0.65s') {
                        if (isMoving) return;
                        isMoving = true;
                        currentIndex = index;
                        heroTrack.style.transition = `transform ${speed} cubic-bezier(0.22, 1, 0.36, 1)`;
                        heroTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
                        updateDots();
                    }

                    heroTrack.addEventListener('transitionend', () => {
                        isMoving = false;
                        if (currentIndex === totalRealSlides + 1) {
                            // Seamless wrap from clone back to first real slide
                            heroTrack.style.transition = 'none';
                            currentIndex = 1;
                            heroTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
                        } else if (currentIndex === 0) {
                            // Seamless wrap from start clone back to last real slide
                            heroTrack.style.transition = 'none';
                            currentIndex = totalRealSlides;
                            heroTrack.style.transform = `translateX(-${currentIndex * 100}%)`;
                        }
                        updateDots();
                    });

                    function nextSlide() {
                        slideTo(currentIndex + 1);
                    }

                    function prevSlide() {
                        slideTo(currentIndex - 1);
                    }

                    function startAutoPlay() {
                        if (autoSlideTimer) clearInterval(autoSlideTimer);
                        autoSlideTimer = setInterval(nextSlide, 3200);
                    }

                    function stopAutoPlay() {
                        if (autoSlideTimer) {
                            clearInterval(autoSlideTimer);
                            autoSlideTimer = null;
                        }
                    }

                    if (nextHeroBtn) {
                        nextHeroBtn.addEventListener('click', () => {
                            nextSlide();
                            startAutoPlay();
                        });
                    }

                    if (prevHeroBtn) {
                        prevHeroBtn.addEventListener('click', () => {
                            prevSlide();
                            startAutoPlay();
                        });
                    }

                    heroDots.forEach(dot => {
                        dot.addEventListener('click', () => {
                            const target = parseInt(dot.getAttribute('data-goto'), 10);
                            if (!isNaN(target)) {
                                slideTo(target + 1);
                                startAutoPlay();
                            }
                        });
                    });

                    if (heroContainer) {
                        heroContainer.addEventListener('mouseenter', stopAutoPlay);
                        heroContainer.addEventListener('mouseleave', startAutoPlay);
                    }

                    // Mobile touch swipe support
                    if (heroViewport) {
                        let touchStartX = 0;
                        let touchEndX = 0;

                        heroViewport.addEventListener('touchstart', (e) => {
                            touchStartX = e.changedTouches[0].screenX;
                            stopAutoPlay();
                        }, { passive: true });

                        heroViewport.addEventListener('touchend', (e) => {
                            touchEndX = e.changedTouches[0].screenX;
                            const diff = touchStartX - touchEndX;
                            if (diff > 45) {
                                nextSlide();
                            } else if (diff < -45) {
                                prevSlide();
                            }
                            startAutoPlay();
                        }, { passive: true });
                    }

                    // Start continuous automatic sliding transition
                    startAutoPlay();
                }
            }
        });
    </script>

