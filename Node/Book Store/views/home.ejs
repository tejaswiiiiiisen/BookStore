<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookStore - Discover Your Next Favorite Book</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }
        @keyframes float-slow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(1.5deg); }
        }
        @keyframes float-reverse {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(10px) rotate(-2deg); }
        }
        @keyframes pulse-soft {
            0%, 100% { opacity: 0.25; transform: scale(1); }
            50% { opacity: 0.45; transform: scale(1.08); }
        }
        .animate-float {
            animation: float-slow 6s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float-reverse 7s ease-in-out infinite;
        }
        .glow-pulse {
            animation: pulse-soft 8s ease-in-out infinite;
        }
        .book-shadow {
            box-shadow: -12px 16px 36px -10px rgba(0, 0, 0, 0.4),
                        0 2px 10px rgba(0, 0, 0, 0.15);
        }
        /* Hero Sliding Carousel Track */
        #hero-slider-track {
            display: flex;
            will-change: transform;
        }
        .hero-slide-item {
            width: 100%;
            flex-shrink: 0;
        }
        /* Hero Section Dark-to-Light Gradient Canvas */
        .hero-gradient-canvas {
            background-color: #171936;
            background-image: 
                /* Subtle purple glow (#39206F) */
                radial-gradient(ellipse 75% 55% at 75% 20%, rgba(57, 32, 111, 0.45) 0%, transparent 70%),
                /* Subtle blue-indigo ambient glow */
                radial-gradient(ellipse 65% 50% at 20% 15%, rgba(67, 56, 202, 0.25) 0%, transparent 65%),
                /* Smooth dark-to-light vertical progression: navy -> soft blue/purple -> light lavender -> soft white -> pure white */
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 32%,
                    #1c204b 45%,
                    #252d64 56%,
                    #344180 66%,
                    #4c5c9e 75%,
                    #6b7bbd 83%,
                    #92a2d6 89%,
                    #becbeb 94%,
                    #e4ecf8 97%,
                    #f5f8fd 98.8%,
                    #ffffff 100%
                );
        }
    </style>
</head>
<body class="bg-white text-gray-900 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <%- include('includes/nav.ejs') %>

    <!-- ============================================================== -->
    <!-- HERO SECTION (BEST WAY)                                        -->
    <!-- ============================================================== -->
    <section class="relative overflow-hidden hero-gradient-canvas text-white -mt-16 pt-28 pb-36 sm:pb-44 lg:pt-36 lg:pb-52">
        <!-- Ambient Background Glows -->
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/30 rounded-full blur-3xl glow-pulse pointer-events-none"></div>
        <div class="absolute top-1/4 right-1/4 w-[450px] h-[450px] bg-purple-600/20 rounded-full blur-3xl glow-pulse pointer-events-none" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 left-3/4 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl glow-pulse pointer-events-none" style="animation-delay: 4s;"></div>

        <!-- Subtle Grid Pattern Overlay with bottom fade mask -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,#000_50%,transparent_85%)] pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
                
                <!-- Left Column: Copy & Call-to-Actions -->
                <div class="lg:col-span-7 space-y-7 text-center lg:text-left">
                    <!-- Main Catchy Title -->
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.12]">
                        Find Your Next
                        <span class="font-serif-title italic font-normal bg-gradient-to-r from-amber-200 via-orange-300 to-rose-400 bg-clip-text text-transparent">
                            Great Read
                        </span>
                        & Fall in Love with Books
                    </h1>

                    <!-- Description -->
                    <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
                        Immerse yourself in world-class bestsellers, inspiring biographies, gripping fantasy, and transformational self-growth books. Delivered directly to your door with care.
                    </p>

                    <!-- Real-time Hero Search Bar -->
                    <div class="max-w-xl mx-auto lg:mx-0">
                        <div class="relative flex items-center bg-white/10 backdrop-blur-lg border border-white/20 rounded-2xl p-2 shadow-2xl focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-400/40 transition">
                            <div class="pl-3 text-slate-400">
                                <svg class="w-5 h-5 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <input 
                                type="text" 
                                id="hero-search-input" 
                                placeholder="Search by title, author, or category..." 
                                class="w-full bg-transparent px-3 py-2 text-white placeholder-slate-400 focus:outline-none text-sm sm:text-base"
                            >
                            <a href="#books-section" class="shrink-0 bg-gradient-to-r from-indigo-500 to-blue-600 hover:from-indigo-600 hover:to-blue-700 text-white font-semibold px-5 py-2.5 rounded-xl shadow-md transition transform active:scale-95 text-sm sm:text-base">
                                Search
                            </a>
                        </div>
                    </div>

                    <!-- Call To Action Buttons -->
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="#books-section" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-blue-600 hover:from-indigo-600 hover:to-blue-700 text-white font-bold text-base shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-0.5 transition-all">
                            <span>Explore Books</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                            </svg>
                        </a>
                        
                        <a href="/category" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-base border border-white/20 backdrop-blur-md hover:-translate-y-0.5 transition-all">
                            <span>Browse Categories</span>
                            <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>

                    <!-- Trust Metrics & Stats -->
                    <div class="pt-6 border-t border-white/10 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
                        <div>
                            <div class="text-2xl sm:text-3xl font-extrabold text-white">15,000+</div>
                            <div class="text-xs sm:text-sm text-slate-400">Happy Readers</div>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-extrabold text-amber-300 flex items-center justify-center lg:justify-start gap-1">
                                <span>4.9</span>
                                <span class="text-lg">★</span>
                            </div>
                            <div class="text-xs sm:text-sm text-slate-400">Trust Rating</div>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">Free</div>
                            <div class="text-xs sm:text-sm text-slate-400">Delivery > ₹499</div>
                        </div>
                    </div>

                </div>

                <!-- Right Column: 3D Floating Book Visual Showcase -->
                <div class="lg:col-span-5 relative flex items-center justify-center py-6 lg:py-0">
                    
                    <!-- Decorative Radial Rings -->
                    <div class="absolute w-[340px] h-[340px] sm:w-[420px] sm:h-[420px] rounded-full border border-indigo-500/20 animate-spin" style="animation-duration: 40s;"></div>
                    <div class="absolute w-[260px] h-[260px] sm:w-[320px] sm:h-[320px] rounded-full border border-dashed border-white/15"></div>

                    <!-- Main Featured Book Sliding Carousel Card -->
                    <div class="relative z-20 animate-float" id="hero-showcase-container">
                        <div class="relative group">
                            <!-- Glowing halo behind book -->
                            <div class="absolute -inset-3 bg-gradient-to-r from-indigo-500 via-purple-600 to-pink-500 rounded-3xl blur-xl opacity-40 group-hover:opacity-75 transition duration-500"></div>
                            
                            <div class="relative w-72 sm:w-80 bg-gradient-to-b from-slate-900 to-indigo-950 p-4 rounded-3xl border border-white/20 book-shadow text-white shadow-2xl overflow-hidden">
                                
                                <% 
                                    const showcaseBooks = (typeof books !== 'undefined' && books && books.length > 0) ? books : [
                                        { name: "Atomic Habits", author: "James Clear", price: 499, category: "Self Growth", image: "img1.png", _id: "1" },
                                        { name: "Rich Dad Poor Dad", author: "Robert T. Kiyosaki", price: 399, category: "Self learning", image: "img2.jpg", _id: "2" },
                                        { name: "The Hobbit", author: "J.R.R. Tolkien", price: 599, category: "Fantasy", image: "img3.png", _id: "3" },
                                        { name: "The Psychology of Money", author: "Morgan Housel", price: 450, category: "Self learning", image: "img4.png", _id: "4" },
                                        { name: "Think and Grow Rich", author: "Napoleon Hill", price: 350, category: "Self learning", image: "img5.png", _id: "5" },
                                        { name: "The Alchemist", author: "Paulo Coelho", price: 299, category: "Fiction", image: "img6.png", _id: "6" },
                                        { name: "Harry Potter & Sorcerer's Stone", author: "J.K. Rowling", price: 699, category: "Fantasy", image: "img7.png", _id: "7" },
                                        { name: "Clean Code", author: "Robert C. Martin", price: 899, category: "Technology", image: "img10.png", _id: "10" }
                                    ];
                                    const showcaseBadges = ["#1 Bestseller", "Top Pick", "Popular", "Must Read", "Editor's Pick", "Trending", "Special Edition", "Hot Choice"];
                                %>

                                <!-- Slider Viewport (Overflow Hidden) -->
                                <div class="relative overflow-hidden w-full rounded-2xl" id="hero-slider-viewport">
                                    <!-- Infinite Sliding Track -->
                                    <div class="flex will-change-transform" id="hero-slider-track">
                                        <% showcaseBooks.forEach((book, idx) => { 
                                            const badge = showcaseBadges[idx % showcaseBadges.length];
                                            const bookTitle = book.name || book.title || 'Featured Book';
                                            const bookCategory = book.category || 'Self Growth';
                                            const bookImage = book.image ? (book.image.startsWith('/') ? book.image : '/' + book.image) : '/img1.png';
                                            const bookPrice = Number(book.price) || 499;
                                            const originalPrice = Math.round(bookPrice * 1.35);
                                            const bookId = book._id ? book._id : encodeURIComponent(bookTitle);
                                        %>
                                            <div class="hero-slide-item w-full shrink-0 flex flex-col justify-between select-none px-0.5" data-index="<%= idx %>">
                                                <!-- Book Image Box -->
                                                <div class="relative h-64 sm:h-76 w-full rounded-2xl overflow-hidden bg-slate-800/90 flex items-center justify-center p-3 border border-white/10 group/item">
                                                    <a href="/books/buy/<%= bookId %>" class="h-full w-full flex items-center justify-center">
                                                        <img 
                                                            src="<%= bookImage %>" 
                                                            alt="<%= bookTitle %>" 
                                                            class="h-full w-auto object-contain drop-shadow-2xl transition duration-500 group-hover/item:scale-105"
                                                            onerror="this.src='/img1.png'"
                                                        >
                                                    </a>

                                                    <!-- Top Left Counter / Live Tag -->
                                                    <span class="absolute top-3 left-3 bg-slate-950/75 backdrop-blur-md text-slate-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-white/10 shadow flex items-center gap-1">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                                        <%= idx + 1 %>/<%= showcaseBooks.length %>
                                                    </span>

                                                    <!-- Top Right Badge -->
                                                    <span class="absolute top-3 right-3 bg-amber-400 text-slate-950 text-xs font-black px-2.5 py-1 rounded-full uppercase tracking-wider shadow">
                                                        <%= badge %>
                                                    </span>
                                                </div>

                                                <!-- Book Details -->
                                                <div class="pt-3 pb-1 px-1">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest truncate"><%= bookCategory %></span>
                                                        <div class="text-amber-300 text-xs font-semibold flex items-center gap-0.5">
                                                            <span>★★★★★</span>
                                                            <span class="text-white/80 ml-0.5">(4.9)</span>
                                                        </div>
                                                    </div>

                                                    <h3 class="text-base sm:text-lg font-bold text-white mt-1 truncate" title="<%= bookTitle %>">
                                                        <%= bookTitle %>
                                                    </h3>

                                                    <div class="flex items-center justify-between mt-2 pt-1 border-t border-white/10">
                                                        <div class="text-lg sm:text-xl font-extrabold text-emerald-400">
                                                            ₹<%= bookPrice %> 
                                                            <span class="text-xs text-slate-400 line-through font-normal ml-1">₹<%= originalPrice %></span>
                                                        </div>
                                                        <div class="flex items-center gap-1.5">
                                                            <a href="/books/add-to-cart/<%= bookId %>" 
                                                               class="px-2.5 py-1 bg-white/10 hover:bg-white/20 active:scale-95 text-white rounded-lg text-xs font-semibold transition"
                                                               title="Add to Shopping Cart">
                                                                + Cart
                                                            </a>
                                                            <a href="/books/buy/<%= bookId %>" 
                                                               class="px-3 py-1 bg-gradient-to-r from-amber-400 to-orange-500 hover:from-amber-500 hover:to-orange-600 active:scale-95 text-slate-950 rounded-lg text-xs font-extrabold shadow-sm transition">
                                                                Buy
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <!-- Slide Navigation Bar: Prev Button, Indicators, Next Button -->
                                <div class="mt-2.5 pt-2 border-t border-white/10 flex items-center justify-between">
                                    <button type="button" 
                                            id="hero-slider-prev" 
                                            class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/25 active:scale-90 flex items-center justify-center text-white text-xs transition border border-white/10 shadow cursor-pointer"
                                            title="Previous book"
                                            aria-label="Previous book">
                                        ‹
                                    </button>

                                    <!-- Pagination Indicators -->
                                    <div class="flex items-center gap-1.5 px-1 overflow-x-auto max-w-[150px] py-1" id="hero-slider-dots">
                                        <% showcaseBooks.forEach((_, i) => { %>
                                            <button type="button" 
                                                    data-goto="<%= i %>" 
                                                    class="hero-slider-dot transition-all duration-300 rounded-full <%= i === 0 ? 'w-5 h-1.5 bg-amber-400' : 'w-1.5 h-1.5 bg-white/30 hover:bg-white/60' %> cursor-pointer" 
                                                    aria-label="Go to book <%= i + 1 %>">
                                            </button>
                                        <% }) %>
                                    </div>

                                    <button type="button" 
                                            id="hero-slider-next" 
                                            class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/25 active:scale-90 flex items-center justify-center text-white text-xs transition border border-white/10 shadow cursor-pointer"
                                            title="Next book"
                                            aria-label="Next book">
                                        ›
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Wide Symmetrical Downward Curved Arc Bottom Transition with Soft Blur-like Gradient Fade -->
        <div class="hero-curved-bottom absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none z-10" aria-hidden="true">
            <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="relative block w-full h-16 sm:h-22 md:h-28 lg:h-36">
                <defs>
                    <!-- Soft feathered blur filter for seamless, borderless edge diffusion -->
                    <filter id="softArcFeather" x="-10%" y="-30%" width="120%" height="160%">
                        <feGaussianBlur in="SourceGraphic" stdDeviation="6" />
                    </filter>
                    
                    <!-- Vertical gradient fade blending the curve into pure white (#FFFFFF) -->
                    <linearGradient id="heroCurveFadeToWhite" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
                        <stop offset="25%" stop-color="#ffffff" stop-opacity="0.3" />
                        <stop offset="55%" stop-color="#ffffff" stop-opacity="0.75" />
                        <stop offset="85%" stop-color="#ffffff" stop-opacity="0.95" />
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="1" />
                    </linearGradient>
                </defs>

                <!-- Layer 1: Soft blur-like gradient fade along the wide downward arc (center slightly lower than edges) -->
                <path d="M-20,0 Q720,70 1460,0 L1460,130 L-20,130 Z" fill="url(#heroCurveFadeToWhite)" filter="url(#softArcFeather)" opacity="0.9" />

                <!-- Layer 2: Feathered soft white transition layer ensuring no harsh lines or color breaks -->
                <path d="M-20,15 Q720,85 1460,15 L1460,130 L-20,130 Z" fill="#ffffff" filter="url(#softArcFeather)" opacity="0.95" />

                <!-- Layer 3: Solid pure white arc seamlessly meeting the white Featured Books section below -->
                <path d="M-20,30 Q720,100 1460,30 L1460,130 L-20,130 Z" fill="#ffffff" />
            </svg>
        </div>
    </section>


    <!-- ============================================================== -->
    <!-- BOOKS SHOWCASE SECTION (SHOW BOOKS)                            -->
    <!-- ============================================================== -->
    <main id="books-section" class="bg-white max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 relative z-20">
        
        <!-- Header & Category Filter Controls -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 pb-6 border-b border-gray-200">
            <div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
                    Featured Books
                </h2>
                <p class="text-gray-500 mt-2 text-sm sm:text-base">
                    Discover handpicked titles loved by readers worldwide. Ready to ship.
                </p>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex flex-wrap items-center gap-2" id="category-filter-container">
                <button type="button" data-filter="all" class="category-pill active-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-indigo-600 text-white shadow-sm shadow-indigo-500/20">
                    All Books
                </button>
                <button type="button" data-filter="self learning" class="category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition bg-white text-gray-700 border border-gray-200 hover:border-indigo-400 hover:text-indigo-600">
                    Self Learning
                </button>
                <button type="button" data-filter="fantasy" class="category-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition bg-white text-gray-700 border border-gray-200 hover:border-indigo-400 hover:text-indigo-600">
                    Fantasy
                </button>
                <a href="/category" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition flex items-center gap-1">
                    <span>All Categories</span>
                    <span>→</span>
                </a>
            </div>
        </div>

        <!-- Books Grid -->
        <% if (books && books.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7" id="books-grid">
                <% books.forEach(book => { %>
                    <div class="book-card group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col"
                         data-category="<%= (book.category || '').toLowerCase() %>"
                         data-title="<%= (book.name || book.title || '').toLowerCase() %>"
                         data-author="<%= (book.author || '').toLowerCase() %>">
                        
                        <!-- Book Image Container -->
                        <div class="relative h-72 sm:h-80 bg-gradient-to-b from-gray-50 to-gray-100 flex items-center justify-center p-6 overflow-hidden">
                            <a href="/books/buy/<%= book._id %>" class="h-full w-full flex items-center justify-center">
                                <img 
                                    src="/<%= book.image %>" 
                                    alt="<%= book.name || book.title || 'Book cover' %>"
                                    class="h-full w-auto max-w-full object-contain drop-shadow-md group-hover:scale-108 transition-transform duration-300"
                                    loading="lazy"
                                >
                            </a>

                            <!-- Category Badge -->
                            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-indigo-700 text-[11px] font-bold px-2.5 py-1 rounded-lg border border-gray-100 shadow-xs">
                                <%= book.category || 'General' %>
                            </span>

                            <!-- Discount Tag -->
                            <span class="absolute top-3 right-3 bg-rose-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider shadow-xs">
                                20% OFF
                            </span>
                        </div>

                        <!-- Book Content -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <!-- Author (if available) -->
                                <% if (book.author) { %>
                                    <p class="text-xs font-medium text-gray-400 mb-1">by <%= book.author %></p>
                                <% } %>

                                <!-- Title -->
                                <h3 class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition-colors line-clamp-2 leading-snug">
                                    <%= book.name || book.title %>
                                </h3>

                                <!-- Rating & Reviews -->
                                <div class="flex items-center gap-2 mt-2">
                                    <div class="text-amber-400 text-sm tracking-tighter">
                                        ★★★★★
                                    </div>
                                    <span class="text-xs font-semibold text-gray-500">4.9</span>
                                </div>
                            </div>

                            <!-- Price & Actions Footer -->
                            <div class="mt-5 pt-4 border-t border-gray-100">
                                <div class="flex items-baseline justify-between mb-4">
                                    <div>
                                        <span class="text-2xl font-extrabold text-indigo-600">₹<%= book.price %></span>
                                        <span class="text-xs text-gray-400 line-through ml-1.5">₹<%= Math.round(Number(book.price || 0) * 1.25) %></span>
                                    </div>
                                    <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">In Stock</span>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <a href="/books/add-to-cart/<%= book._id %>" 
