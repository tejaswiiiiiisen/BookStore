<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - BookStore</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Seamless Hero Dark Navy to Pure White Gradient */
        .hero-gradient-canvas {
            background-color: #171936;
            background-image: 
                radial-gradient(ellipse 70% 55% at 75% 25%, rgba(147, 51, 234, 0.22) 0%, transparent 70%),
                radial-gradient(ellipse 60% 45% at 20% 15%, rgba(99, 102, 241, 0.20) 0%, transparent 65%),
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 46%,
                    #1a1e43 58%,
                    #212756 68%,
                    #2d356f 77%,
                    #444f8e 84%,
                    #6976b0 89.5%,
                    #9aa6d3 93.5%,
                    #ccd3ee 96.5%,
                    #f3f5fb 98.8%,
                    #ffffff 100%
                );
        }
    </style>
</head>
<body class="bg-white text-gray-900 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <%- include('includes/nav.ejs') %>

    <!-- Hero Header Banner with Seamless Dark Navy to White Gradient -->
    <section class="relative overflow-hidden hero-gradient-canvas text-white -mt-16 pt-28 pb-20 sm:pb-24 lg:pt-36 lg:pb-28">
        <!-- Ambient Background Glows -->
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/4 right-1/4 w-[450px] h-[450px] bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/3 left-3/4 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Subtle Grid Pattern Overlay with bottom fade mask -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,#000_50%,transparent_85%)] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 border border-indigo-400/20 px-3 py-1 rounded-full mb-3">
                💬 Get In Touch
            </span>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
                Contact Our Team
            </h1>
            <p class="text-slate-300 mt-3 text-sm sm:text-base max-w-xl mx-auto">
                Have questions about your order, book recommendations, or shipping? Send us a message and we will respond promptly.
            </p>
        </div>
    </section>

    <!-- Main Content Section on Pure White -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white">

        <!-- Status Alerts -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="mb-8 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-xs">
                <span class="text-2xl">✓</span>
                <div>
                    <h4 class="font-bold text-sm">Message Sent Successfully!</h4>
                    <p class="text-xs text-emerald-700 mt-0.5">Thank you for reaching out. Our support team will get back to you shortly.</p>
                </div>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-8 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-3 shadow-xs">
                <span class="text-2xl">⚠️</span>
                <div>
                    <h4 class="font-bold text-sm">Message Failed to Send</h4>
                    <p class="text-xs text-rose-700 mt-0.5">Please check your network connection or try again later.</p>
                </div>
            </div>
        <% } %>

        <!-- Modern Contact Container -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden grid md:grid-cols-5">
            
            <!-- Left Info Panel -->
            <div class="md:col-span-2 bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-900 text-white p-8 md:p-10 flex flex-col justify-between">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">Direct Support</span>
                    <h3 class="text-2xl font-extrabold mt-1 mb-4">Let's Connect</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-8">
                        Whether you are looking for specific editions or need assistance with your cart, we are delighted to assist you.
                    </p>

                    <div class="space-y-5 text-sm">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-indigo-300 shrink-0">
                                ✉️
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">Email Us</p>
                                <p class="font-bold text-white text-xs sm:text-sm">support@bookstore.com</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-indigo-300 shrink-0">
                                📞
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">Call Us</p>
                                <p class="font-bold text-white text-xs sm:text-sm">+91 987456321</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center text-indigo-300 shrink-0">
                                📍
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">Location</p>
                                <p class="font-bold text-white text-xs sm:text-sm">Main Street Bookstore, India</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-8 mt-8 border-t border-white/10 text-xs text-slate-400">
                    <p>Response time: Usually within 2-4 hours on business days.</p>
                </div>
            </div>

            <!-- Right Form Panel -->
            <div class="md:col-span-3 p-8 md:p-10 bg-white">
                <h3 class="text-xl font-bold text-gray-900 mb-6">Send Us a Message</h3>

                <form action="/contact" method="POST" class="space-y-4">
                    
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Full Name *</label>
                        <input 
                            type="text" 
                            name="name" 
                            required
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none transition"
                        >
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1.5">Email Address *</label>
                            <input 
                                type="email" 
                                name="email" 
                                placeholder="name@example.com" 
                                required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none transition"
                            >
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1.5">Mobile Number *</label>
                            <input 
                                type="text" 
                                name="mob" 
                                placeholder="+91 987456321" 
                                required
                                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none transition"
                            >
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Your Message *</label>
                        <textarea 
                            name="message" 
                            rows="4" 
                            placeholder="Write your message, order inquiry, or book request..." 
                            required
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none transition resize-vertical"
                        ></textarea>
                    </div>

                    <div class="pt-2">
                        <button 
                            type="submit" 
                            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-bold text-sm shadow-md shadow-indigo-500/20 transition transform active:scale-98 cursor-pointer flex items-center justify-center gap-2"
                        >
                            <span>Send Message</span>
                            <span>→</span>
                        </button>
                    </div>

                </form>
            </div>

        </div>

    </main>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

</body>
</html>