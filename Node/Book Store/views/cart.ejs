<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - BookStore</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }
        /* Rich Dark Navy & Purple Header Gradient */
        .cart-hero-gradient {
            background-color: #171936;
            background-image: 
                radial-gradient(ellipse 75% 55% at 75% 20%, rgba(57, 32, 111, 0.45) 0%, transparent 70%),
                radial-gradient(ellipse 65% 50% at 20% 15%, rgba(67, 56, 202, 0.25) 0%, transparent 65%),
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 45%,
                    #1f2656 70%,
                    #2d3775 88%,
                    #3f4e9a 100%
                );
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased selection:bg-indigo-500 selection:text-white flex flex-col min-h-screen">

    <!-- Header Navigation -->
    <%- include('includes/nav.ejs') %>

    <% 
        const items = cartItems || [];
        const totalItemsCount = items.reduce((acc, item) => acc + (Number(item.quantity) || 1), 0);
        const freeShippingThreshold = 499;
        const currentTotal = Number(total) || 0;
        const freeShippingQualified = currentTotal >= freeShippingThreshold;
        const amountNeeded = Math.max(0, freeShippingThreshold - currentTotal);
        const progressPercent = Math.min(100, Math.round((currentTotal / freeShippingThreshold) * 100));
    %>

    <!-- Hero Header Banner -->
    <section class="relative overflow-hidden cart-hero-gradient text-white -mt-16 pt-28 pb-16 lg:pt-36 lg:pb-20">
        <!-- Subtle Grid Overlay -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,#000_50%,transparent_90%)] pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-4">
                <a href="/" class="hover:text-white transition flex items-center gap-1">
                    <span>Home</span>
                </a>
                <span>/</span>
                <a href="/books" class="hover:text-white transition">Books</a>
                <span>/</span>
                <span class="text-amber-300">Cart</span>
            </nav>

            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold text-indigo-300 mb-3">
                        <span>🛒 Shopping Bag</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span><%= totalItemsCount %> <%= totalItemsCount === 1 ? 'Item' : 'Items' %></span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
                        Your Shopping Cart
                    </h1>
                    <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
                        Review your handpicked titles, adjust quantities, and complete your order with fast, secure checkout.
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <a href="/books" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 backdrop-blur-md transition shadow-md">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        <span>Continue Browsing</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Cart Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 relative z-20 pb-20">
        
        <% if (!items || items.length === 0) { %>
            <!-- Empty Cart State -->
            <div class="bg-white rounded-3xl shadow-xl shadow-gray-200/50 border border-gray-100 p-8 sm:p-16 text-center max-w-2xl mx-auto my-8">
                <div class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-tr from-indigo-50 to-blue-50 border border-indigo-100 flex items-center justify-center text-4xl shadow-inner mb-6">
                    📚
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
                    Your Shopping Cart is Empty
                </h2>
                <p class="text-gray-500 mt-3 text-sm sm:text-base max-w-md mx-auto leading-relaxed">
                    Looks like you haven't added any books to your cart yet. Discover bestselling literature, self-growth guides, and fiction classics.
                </p>
                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/books" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-bold shadow-lg shadow-indigo-500/25 transition transform active:scale-95 text-sm sm:text-base">
                        <span>Explore All Books</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </a>
                    <a href="/category" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition">
                        <span>Browse Categories</span>
                    </a>
                </div>
            </div>
        <% } else { %>
            <!-- Active Cart Layout (Grid 12 cols: 8 cols items + 4 cols summary) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Left Column: Items List -->
                <div class="lg:col-span-8 space-y-4">
                    
                    <!-- Free Delivery Progress Meter -->
                    <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-gray-100">
                        <div class="flex items-center justify-between text-xs sm:text-sm mb-2">
                            <span class="font-bold text-gray-900 flex items-center gap-2">
                                <span>🚚</span>
                                <% if (freeShippingQualified) { %>
                                    <span class="text-emerald-600">Great news! You have unlocked <strong>FREE Delivery</strong> on this order.</span>
                                <% } else { %>
                                    <span>Add <strong class="text-indigo-600">₹<%= amountNeeded %></strong> more to unlock <strong>FREE Delivery</strong>!</span>
                                <% } %>
                            </span>
                            <span class="font-extrabold <%= freeShippingQualified ? 'text-emerald-600' : 'text-indigo-600' %>">
                                <%= progressPercent %>%
                            </span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r <%= freeShippingQualified ? 'from-emerald-500 to-teal-400' : 'from-indigo-500 to-blue-500' %> rounded-full transition-all duration-500" style="width: <%= progressPercent %>%;"></div>
                        </div>
                    </div>

                    <!-- Cart Items Card Container -->
                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500">
                                Books In Your Cart (<%= totalItemsCount %>)
                            </h2>
                            <a href="/cart/clear" onclick="return confirm('Are you sure you want to clear your cart?')" class="text-xs font-semibold text-rose-500 hover:text-rose-700 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                <span>Clear All</span>
                            </a>
                        </div>

                        <div class="divide-y divide-gray-100">
                            <% items.forEach((item, index) => { %>
                                <% 
                                    const qty = Number(item.quantity) || 1;
                                    const unitPrice = Number(item.price) || 0;
                                    const itemSubtotal = unitPrice * qty;
                                    const imgSrc = item.image ? (item.image.startsWith('/') ? item.image : '/' + item.image) : '/img1.png';
                                    const bookName = item.name || item.title || 'Untitled Book';
                                %>
                                <div class="p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 hover:bg-gray-50/50 transition duration-150">
                                    
                                    <!-- Book Cover & Info -->
                                    <div class="flex items-center gap-4 sm:gap-5 w-full sm:w-auto">
                                        <div class="relative w-20 h-28 sm:w-24 sm:h-32 shrink-0 rounded-xl overflow-hidden bg-slate-900/5 border border-gray-200/80 p-1 flex items-center justify-center shadow-xs">
                                            <img 
                                                src="<%= imgSrc %>" 
                                                alt="<%= bookName %>" 
                                                class="w-full h-full object-contain drop-shadow-md"
                                                onerror="this.src='/img1.png'"
                                            >
                                        </div>
                                        <div class="space-y-1">
                                            <% if (item.category) { %>
                                                <span class="inline-block text-[10px] font-black uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-100">
                                                    <%= item.category %>
                                                </span>
                                            <% } %>
                                            <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">
                                                <%= bookName %>
                                            </h3>
                                            <% if (item.author) { %>
                                                <p class="text-xs text-gray-500">by <%= item.author %></p>
                                            <% } %>
                                            <div class="pt-1 flex items-center gap-2">
                                                <span class="text-sm font-semibold text-gray-700">₹<%= unitPrice %></span>
                                                <span class="text-xs text-gray-400">each</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quantity Stepper & Subtotal -->
                                    <div class="flex items-center justify-between sm:justify-end gap-6 sm:gap-8 w-full sm:w-auto pt-3 sm:pt-0 border-t sm:border-t-0 border-gray-100">
                                        
                                        <!-- Interactive Quantity Stepper -->
                                        <div class="flex items-center bg-gray-100 rounded-xl p-1 border border-gray-200 shadow-inner">
                                            <!-- Decrease Button -->
                                            <a 
                                                href="/cart/decrease/<%= item._id %>" 
                                                class="w-8 h-8 rounded-lg bg-white hover:bg-gray-200 text-gray-700 flex items-center justify-center font-bold text-base shadow-xs transition active:scale-95"
                                                title="Decrease quantity by 1"
                                            >
                                                −
                                            </a>
                                            <!-- Live Quantity -->
                                            <span class="w-10 text-center font-extrabold text-sm sm:text-base text-gray-900 tabular-nums">
                                                <%= qty %>
                                            </span>
                                            <!-- Increase Button -->
                                            <a 
                                                href="/cart/increase/<%= item._id %>" 
                                                class="w-8 h-8 rounded-lg bg-white hover:bg-gray-200 text-gray-700 flex items-center justify-center font-bold text-base shadow-xs transition active:scale-95"
                                                title="Increase quantity by 1"
                                            >
                                                +
                                            </a>
                                        </div>

                                        <!-- Item Subtotal -->
                                        <div class="text-right min-w-[90px]">
                                            <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block">Subtotal</span>
                                            <span class="text-lg sm:text-xl font-extrabold text-gray-900">
                                                ₹<%= itemSubtotal %>
                                            </span>
                                        </div>

                                        <!-- Remove Icon Button -->
                                        <a 
                                            href="/cart/remove/<%= item._id %>" 
                                            class="w-9 h-9 rounded-xl bg-gray-100 hover:bg-rose-50 text-gray-400 hover:text-rose-600 flex items-center justify-center transition"
                                            title="Remove <%= bookName %> from cart"
                                        >
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </a>

                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Card Footer Links -->
                        <div class="p-4 sm:p-5 bg-gray-50/70 border-t border-gray-100 flex items-center justify-between">
                            <a href="/books" class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 hover:text-indigo-800 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                </svg>
                                <span>Continue Shopping</span>
                            </a>
                            <span class="text-xs text-gray-400 font-medium hidden sm:inline">
                                Instant delivery dispatched within 24h
                            </span>
                        </div>
                    </div>

                    <!-- Trust Bar Below Items -->
                    <div class="grid grid-cols-3 gap-3 pt-2 text-center">
                        <div class="bg-white p-3.5 rounded-2xl border border-gray-100 shadow-xs">
                            <span class="text-lg">🛡️</span>
                            <p class="text-xs font-bold text-gray-900 mt-1">100% Authentic</p>
                            <p class="text-[10px] text-gray-500">Verified publisher editions</p>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-gray-100 shadow-xs">
                            <span class="text-lg">⚡</span>
                            <p class="text-xs font-bold text-gray-900 mt-1">Fast Delivery</p>
                            <p class="text-[10px] text-gray-500">Ships within 24 hours</p>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-gray-100 shadow-xs">
                            <span class="text-lg">🔄</span>
                            <p class="text-xs font-bold text-gray-900 mt-1">7 Days Return</p>
                            <p class="text-[10px] text-gray-500">Hassle-free guarantee</p>
                        </div>
                    </div>

                </div>

                <!-- Right Column: Order Summary -->
                <div class="lg:col-span-4">
                    <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-xl shadow-gray-200/50 border border-gray-100 sticky top-24 space-y-6">
                        
                        <div class="border-b border-gray-100 pb-4">
                            <h2 class="text-xl font-extrabold text-gray-900">
                                Order Summary
                            </h2>
                            <p class="text-xs text-gray-500 mt-1">
                                Complete breakdown for your <%= totalItemsCount %> <%= totalItemsCount === 1 ? 'item' : 'items' %>
                            </p>
                        </div>

                        <!-- Price Breakdown Rows -->
                        <div class="space-y-3.5 text-sm">
                            <div class="flex items-center justify-between text-gray-600">
                                <span>Items Subtotal</span>
                                <span class="font-bold text-gray-900">₹<%= currentTotal %></span>
                            </div>
                            
                            <div class="flex items-center justify-between text-gray-600">
                                <span class="flex items-center gap-1.5">
                                    <span>Shipping</span>
                                    <span class="text-[10px] font-bold text-gray-400">(Express)</span>
                                </span>
                                <% if (freeShippingQualified) { %>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-xs text-gray-400 line-through">₹70</span>
                                        <span class="font-extrabold text-emerald-600 uppercase text-xs tracking-wider bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">FREE</span>
                                    </div>
                                <% } else { %>
                                    <span class="font-bold text-gray-900">₹70</span>
                                <% } %>
                            </div>

                            <div class="flex items-center justify-between text-gray-600">
                                <span>Taxes (GST)</span>
                                <span class="font-semibold text-emerald-600 text-xs">Included</span>
                            </div>

                            <!-- Discount Row -->
                            <div class="flex items-center justify-between text-indigo-600 bg-indigo-50/60 p-2.5 rounded-xl border border-indigo-100">
                                <span class="text-xs font-bold flex items-center gap-1">
                                    <span>🏷️</span>
                                    <span>Reader Perk</span>
                                </span>
                                <span class="text-xs font-extrabold">Applied at Checkout</span>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="border-t border-gray-200 pt-4">
                            <div class="flex items-baseline justify-between mb-1">
                                <span class="text-base font-bold text-gray-900">Grand Total</span>
                                <div class="text-right">
                                    <span class="text-3xl font-black text-gray-900 tracking-tight">
                                        ₹<%= freeShippingQualified ? currentTotal : currentTotal + 70 %>
                                    </span>
                                </div>
                            </div>
                            <p class="text-[11px] text-gray-400 text-right">Inclusive of all local taxes</p>
                        </div>

                        <!-- Checkout Button -->
                        <div class="space-y-3 pt-2">
                            <button 
                                type="button" 
                                id="open-checkout-modal-btn" 
                                class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-indigo-700 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-extrabold text-base shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 hover:-translate-y-0.5 transition-all cursor-pointer"
                            >
                                <span>Proceed to Checkout</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            </button>

                            <a 
                                href="/contact" 
                                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold text-xs border border-gray-200 transition"
                            >
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                                <span>Need help? Contact Reader Support</span>
                            </a>
                        </div>

                        <!-- Trust Guarantees -->
                        <div class="pt-2 border-t border-gray-100 flex items-center justify-center gap-2 text-xs text-gray-500 font-medium">
                            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                            <span>Encrypted 256-bit Secure Checkout</span>
                        </div>

                    </div>
                </div>

            </div>
        <% } %>

    </main>

    <!-- Checkout Modal Dialog -->
    <div id="checkout-modal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-gray-100 max-h-[92vh] overflow-y-auto">
            
            <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-lg">
                        🛍️
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900">Complete Your Order</h3>
                        <p class="text-xs text-gray-500">Instant dispatch to your address</p>
                    </div>
                </div>
                <button type="button" id="close-checkout-modal-btn" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center font-bold text-sm transition">
                    ✕
                </button>
            </div>

            <!-- Checkout Order Form -->
            <form id="order-checkout-form" class="space-y-4 pt-5">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Full Name *</label>
                    <input type="text" name="fullName" required placeholder="e.g. Rahul Sharma" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Phone Number *</label>
                        <input type="tel" name="phone" required placeholder="+91 987456321" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Pincode *</label>
                        <input type="text" name="pincode" required placeholder="e.g. 110001" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Shipping Address *</label>
                    <textarea name="address" required rows="2" placeholder="House / Flat No., Street, Area, City" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 text-sm"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Payment Method</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="border border-indigo-500 bg-indigo-50/50 rounded-xl p-3 flex items-center gap-2.5 cursor-pointer">
                            <input type="radio" name="payment" value="cod" checked class="text-indigo-600 focus:ring-indigo-500">
                            <span class="text-xs font-bold text-gray-800">Cash on Delivery</span>
                        </label>
                        <label class="border border-gray-200 hover:border-gray-300 rounded-xl p-3 flex items-center gap-2.5 cursor-pointer">
                            <input type="radio" name="payment" value="upi" class="text-indigo-600 focus:ring-indigo-500">
                            <span class="text-xs font-bold text-gray-800">UPI / QR Pay</span>
                        </label>
                    </div>
                </div>

                <!-- Order Total Summary Box -->
                <div class="bg-gray-50 rounded-2xl p-4 border border-gray-200 flex items-center justify-between mt-2">
                    <div>
                        <p class="text-xs text-gray-500 font-medium"><%= totalItemsCount %> <%= totalItemsCount === 1 ? 'Book' : 'Books' %> in Order</p>
                        <p class="text-sm font-bold text-gray-900">Total Payable Amount</p>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-black text-indigo-600">
                            ₹<%= freeShippingQualified ? currentTotal : currentTotal + 70 %>
                        </p>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-extrabold text-base shadow-lg shadow-emerald-500/30 transition transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
                        <span>Place Order Now</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </button>
                </div>
            </form>

            <!-- Order Success Confirmation View (Hidden by default) -->
            <div id="order-success-view" class="hidden text-center py-6 space-y-4">
                <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center text-3xl animate-bounce">
                    ✓
                </div>
                <h3 class="text-2xl font-extrabold text-gray-900">Order Placed Successfully!</h3>
                <p class="text-sm text-gray-600 max-w-sm mx-auto">
                    Thank you! Your books are being packed and will be dispatched to your address within 24 hours.
                </p>
                <div class="pt-4 flex flex-col gap-2">
                    <a href="/cart/clear" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow transition">
                        Finish & Clear Cart
                    </a>
                    <a href="/books" class="w-full py-2.5 text-xs text-gray-600 font-semibold hover:text-gray-900">
                        Continue Shopping More Books
                    </a>
                </div>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

    <script>
        // Modal interaction controls
        const checkoutModal = document.getElementById('checkout-modal');
        const openBtn = document.getElementById('open-checkout-modal-btn');
        const closeBtn = document.getElementById('close-checkout-modal-btn');
        const orderForm = document.getElementById('order-checkout-form');
        const successView = document.getElementById('order-success-view');

        if (openBtn && checkoutModal) {
            openBtn.addEventListener('click', () => {
                checkoutModal.classList.remove('hidden');
            });
        }

        const closeModal = () => {
            if (checkoutModal) checkoutModal.classList.add('hidden');
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);

        if (checkoutModal) {
            checkoutModal.addEventListener('click', (e) => {
                if (e.target === checkoutModal) closeModal();
            });
        }

        if (orderForm) {
            orderForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(orderForm);
                const orderData = {
                    fullName: formData.get('fullName'),
                    phone: formData.get('phone'),
                    pincode: formData.get('pincode'),
                    address: formData.get('address'),
                    payment: formData.get('payment')
                };

                try {
                    await fetch('/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(orderData)
                    });
                } catch (err) {
                    console.error('Error saving order:', err);
                }

                orderForm.classList.add('hidden');
                if (successView) successView.classList.remove('hidden');
            });
        }
    </script>
</body>
</html>
