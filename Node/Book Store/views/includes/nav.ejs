                                    <span>📚</span> Browse Catalog
                                </span>
                                <span class="text-[10px] text-slate-400 font-semibold">Catalog</span>
                            </a>
                            <a href="/contact" class="flex items-center justify-between px-3 py-2 rounded-xl text-slate-200 hover:text-white hover:bg-white/10 transition">
                                <span class="flex items-center gap-2.5">
