    <!-- Mobile Navigation Subbar -->
    <div class="md:hidden flex items-center justify-around border-t border-white/10 py-2.5 px-3 bg-[#171936]/60 backdrop-blur-xl text-xs font-semibold text-slate-200">
        <a href="/" class="hover:text-white py-1">Home</a>
        <a href="/books" class="hover:text-white py-1">Books</a>
        <a href="/category" class="hover:text-white py-1">Categories</a>
        <a href="/contact" class="hover:text-white py-1">Contact</a>
