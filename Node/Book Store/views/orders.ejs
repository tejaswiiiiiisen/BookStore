<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders & Tracking - BookStore</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }
        .orders-hero-gradient {
            background-color: #171936;
            background-image: 
                radial-gradient(ellipse 75% 55% at 75% 20%, rgba(57, 32, 111, 0.45) 0%, transparent 70%),
                radial-gradient(ellipse 65% 50% at 20% 15%, rgba(67, 56, 202, 0.25) 0%, transparent 65%),
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 45%,
                    #1f2656 70%,
                    #2d3775 88%,
                    #3f4e9a 100%
                );
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 antialiased selection:bg-indigo-500 selection:text-white flex flex-col min-h-screen">

    <!-- Header & Navigation -->
    <header class="orders-hero-gradient text-white relative">
        <%- include('includes/nav.ejs') %>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-center">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-indigo-200 text-xs font-bold uppercase tracking-wider mb-4 shadow-xs">
                <span>📦</span>
                <span>Live Order Tracking</span>
            </span>
            <h1 class="font-serif-title text-3xl sm:text-5xl font-black tracking-tight text-white mb-3">
                My Orders & Deliveries
            </h1>
            <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto">
                Check order confirmation, payment status, real-time dispatch progress, and delivery schedule.
            </p>
        </div>
    </header>

    <!-- Main Orders Content -->
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 w-full">

        <% if (orders && orders.length > 0) { %>

            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl font-black text-gray-900">
                        Order History (<%= orders.length %>)
                    </h2>
                    <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                        Showing all verified placed orders
                    </p>
                </div>
                <a href="/books" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs transition">
                    <span>+ Shop More Books</span>
                </a>
            </div>

            <div class="space-y-8">
                <% orders.forEach((order, index) => { %>
                    <% 
                        const ordDate = new Date(order.createdAt || Date.now());
                        const dayName = ordDate.toLocaleDateString('en-IN', { weekday: 'long' });
                        const dateFormatted = ordDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                        const timeFormatted = ordDate.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
                        const orderCode = order.orderId || ('ORD-' + String(order._id || index).slice(-6).toUpperCase());
                        const items = order.items || [];
                        const currentStep = Number(order.statusStep) || 2; // Step 2: Processing
                    %>

                    <!-- Order Card -->
                    <div class="bg-white rounded-3xl border border-gray-200 shadow-xl shadow-gray-200/40 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:border-indigo-100">
                        
                        <!-- Top Header: Order ID, Date/Day/Time & Payment Successful Badge -->
                        <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-5 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                            
                            <div class="space-y-1.5">
                                <div class="flex flex-wrap items-center gap-2.5">
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Order ID:</span>
                                    <span class="text-base sm:text-lg font-black text-amber-300 font-mono tracking-wide">
                                        #<%= orderCode %>
                                    </span>

                                    <!-- Payment Successful Badge -->
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-black uppercase tracking-wider shadow-xs">
                                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                        <span>Payment Successful</span>
                                    </span>
                                </div>

                                <!-- Date, Day & Time Display -->
                                <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 font-medium">
                                    <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    <span>
                                        <strong class="text-white"><%= dayName %></strong>, <%= dateFormatted %> &bull; <strong class="text-amber-200"><%= timeFormatted %></strong>
                                    </span>
                                </div>
                            </div>

                            <!-- Right: Grand Total -->
                            <div class="md:text-right border-t md:border-t-0 pt-3 md:pt-0 border-white/10 flex items-center md:block justify-between">
                                <span class="text-xs text-slate-400 font-semibold block">Total Paid</span>
                                <span class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                                    ₹<%= order.totalAmount || 499 %>
                                </span>
                            </div>

                        </div>

                        <!-- Progress Line: Order Process to Deliver Stepper -->
                        <div class="p-6 sm:p-8 bg-slate-50/70 border-b border-gray-100">
                            
                            <div class="mb-4 flex items-center justify-between">
                                <h3 class="text-xs sm:text-sm font-extrabold text-gray-700 uppercase tracking-wider flex items-center gap-2">
                                    <span>📍</span>
                                    <span>Delivery Status Timeline</span>
                                </h3>
                                <span class="text-xs font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-full">
                                    Status: <%= order.orderStatus || 'Processing & Packing' %>
                                </span>
                            </div>

                            <!-- Visual Step Bar with Line -->
                            <div class="relative py-4">
                                
                                <!-- Background Connecting Line -->
                                <div class="absolute top-9 left-6 right-6 sm:left-12 sm:right-12 h-1.5 bg-gray-200 rounded-full -translate-y-1/2 z-0"></div>
                                
                                <!-- Active Colored Progress Line -->
                                <div class="absolute top-9 left-6 sm:left-12 h-1.5 bg-gradient-to-r from-emerald-500 via-indigo-600 to-indigo-500 rounded-full -translate-y-1/2 z-0 transition-all duration-700"
                                     style="width: <%= currentStep === 1 ? '15%' : (currentStep === 2 ? '48%' : (currentStep === 3 ? '80%' : '94%')) %>;">
                                </div>

                                <!-- 4 Stage Steps -->
                                <div class="relative z-10 grid grid-cols-4 text-center">
                                    
                                    <!-- Step 1: Order Placed -->
                                    <div class="flex flex-col items-center">
                                        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black text-sm shadow-md ring-4 ring-emerald-100">
                                            ✓
                                        </div>
                                        <p class="text-xs sm:text-sm font-extrabold text-gray-900 mt-2.5">Order Placed</p>
                                        <p class="text-[10px] sm:text-xs text-emerald-600 font-semibold"><%= timeFormatted %></p>
                                    </div>

                                    <!-- Step 2: Processing -->
                                    <div class="flex flex-col items-center">
                                        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-md ring-4 ring-indigo-100 animate-pulse">
                                            📦
                                        </div>
                                        <p class="text-xs sm:text-sm font-extrabold text-indigo-700 mt-2.5">Processing</p>
                                        <p class="text-[10px] sm:text-xs text-gray-500 font-medium">Packing & Quality Check</p>
                                    </div>

                                    <!-- Step 3: Shipped -->
                                    <div class="flex flex-col items-center">
                                        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full <%= currentStep >= 3 ? 'bg-indigo-600 text-white shadow-md ring-4 ring-indigo-100' : 'bg-gray-200 text-gray-400' %> flex items-center justify-center font-bold text-sm">
                                            🚚
                                        </div>
                                        <p class="text-xs sm:text-sm font-bold <%= currentStep >= 3 ? 'text-gray-900 font-extrabold' : 'text-gray-400' %> mt-2.5">Shipped</p>
                                        <p class="text-[10px] sm:text-xs text-gray-400">Ready for Transit</p>
                                    </div>

                                    <!-- Step 4: Delivered -->
                                    <div class="flex flex-col items-center">
                                        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full <%= currentStep >= 4 ? 'bg-emerald-600 text-white shadow-md' : 'bg-gray-200 text-gray-400' %> flex items-center justify-center font-bold text-sm">
                                            🏠
                                        </div>
                                        <p class="text-xs sm:text-sm font-bold <%= currentStep >= 4 ? 'text-gray-900 font-extrabold' : 'text-gray-400' %> mt-2.5">Delivered</p>
                                        <p class="text-[10px] sm:text-xs text-gray-400">Arrives in 2-3 Days</p>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Ordered Books & Items List -->
                        <div class="p-6 sm:p-8 space-y-4">
                            <h4 class="text-xs font-extrabold text-gray-400 uppercase tracking-wider mb-2">
                                Ordered Books (<%= items.length %> <%= items.length === 1 ? 'Book' : 'Books' %>)
                            </h4>

                            <div class="divide-y divide-gray-100">
                                <% items.forEach(bookItem => { %>
                                    <% 
                                        const rawImg = bookItem.image || 'img1.png';
                                        const bookImg = rawImg.startsWith('http') ? rawImg : ('/' + rawImg.replace(/^\/+/, ''));
                                        const bTitle = bookItem.title || bookItem.name || 'Book';
                                        const bPrice = Number(bookItem.price) || 0;
                                        const bQty = Number(bookItem.quantity) || 1;
                                    %>
                                    <div class="py-4 first:pt-0 last:pb-0 flex items-center justify-between gap-4">
                                        <div class="flex items-center gap-4">
                                            <div class="w-16 h-20 sm:w-20 sm:h-24 rounded-xl bg-gray-50 border border-gray-200 p-1 flex items-center justify-center shrink-0 overflow-hidden shadow-xs">
                                                <img 
                                                    src="<%= bookImg %>" 
                                                    alt="<%= bTitle %>" 
                                                    class="w-full h-full object-contain drop-shadow"
                                                    onerror="this.src='/img1.png'"
                                                >
                                            </div>
                                            <div>
                                                <h5 class="text-sm sm:text-base font-extrabold text-gray-900 leading-snug">
                                                    <%= bTitle %>
                                                </h5>
                                                <div class="flex items-center gap-3 mt-1 text-xs text-gray-500">
                                                    <span>Qty: <strong class="text-gray-900 font-bold"><%= bQty %></strong></span>
                                                    <span>&bull;</span>
                                                    <span>Price: <strong class="text-gray-900 font-bold">₹<%= bPrice %></strong> each</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="text-right shrink-0">
                                            <span class="text-xs text-gray-400 block font-semibold">Subtotal</span>
                                            <span class="text-base sm:text-lg font-black text-gray-900">
                                                ₹<%= bPrice * bQty %>
                                            </span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <!-- Shipping Address & Order Summary Footer -->
                        <div class="bg-gray-50 p-6 sm:p-8 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-xs sm:text-sm">
                            
                            <div>
                                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">
                                    Delivery Address
                                </span>
                                <p class="font-bold text-gray-900"><%= order.fullName || 'Book Reader' %></p>
                                <p class="text-gray-600 mt-0.5"><%= order.address || 'Standard Delivery' %></p>
                                <p class="text-gray-600">PIN: <strong class="text-gray-800"><%= order.pincode || '110001' %></strong></p>
                            </div>

                            <div>
                                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">
                                    Contact & Communication
                                </span>
                                <p class="text-gray-600">Phone: <strong class="text-gray-900"><%= order.phone || '+91 987456321' %></strong></p>
                                <p class="text-gray-600 mt-0.5">SMS updates will be sent to this number</p>
                            </div>

                            <div>
                                <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider block mb-1">
                                    Payment Summary
                                </span>
                                <p class="text-gray-600">Method: <strong class="text-gray-900"><%= order.paymentMethod || 'Cash on Delivery' %></strong></p>
                                <div class="mt-1 flex items-center gap-1.5 text-emerald-700 font-bold text-xs">
                                    <span>🛡️</span>
                                    <span>Payment Verified & Confirmed</span>
                                </div>
                            </div>

                        </div>

                    </div>
                <% }) %>
            </div>

        <% } else { %>

            <!-- Empty State (No orders yet) -->
            <div class="bg-white rounded-3xl border border-dashed border-gray-300 p-12 sm:p-16 text-center max-w-lg mx-auto shadow-xs">
                <div class="w-20 h-20 rounded-3xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-4xl mx-auto mb-4 text-indigo-600">
                    📚
                </div>
                <h3 class="text-2xl font-black text-gray-900 mb-2">No Orders Placed Yet</h3>
                <p class="text-sm text-gray-500 mb-6 max-w-sm mx-auto">
                    Looks like you haven't ordered any books yet. Explore our bestsellers and start reading today!
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/books" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-extrabold text-sm shadow-md hover:from-indigo-700 hover:to-blue-700 transition">
                        Browse Books Catalog
                    </a>
                    <a href="/cart" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm transition">
                        View Cart
                    </a>
                </div>
            </div>

        <% } %>

    </main>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

</body>
</html>
