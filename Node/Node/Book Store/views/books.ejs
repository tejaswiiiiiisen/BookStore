<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books Catalog - BookStore</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }
        /* Seamless Hero Dark Navy to Pure White Gradient */
        .hero-gradient-canvas {
            background-color: #171936;
            background-image: 
                radial-gradient(ellipse 70% 55% at 75% 25%, rgba(147, 51, 234, 0.22) 0%, transparent 70%),
                radial-gradient(ellipse 60% 45% at 20% 15%, rgba(99, 102, 241, 0.20) 0%, transparent 65%),
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 46%,
                    #1a1e43 58%,
                    #212756 68%,
                    #2d356f 77%,
                    #444f8e 84%,
                    #6976b0 89.5%,
                    #9aa6d3 93.5%,
                    #ccd3ee 96.5%,
                    #f3f5fb 98.8%,
                    #ffffff 100%
                );
        }
    </style>
</head>
<body class="bg-white text-gray-900 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <%- include('includes/nav.ejs') %>

    <!-- Toast Notification for Added Item -->
    <div id="toast-notification" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-slate-900/95 backdrop-blur-md text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-white/10 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
                ✓
            </div>
            <div>
                <p class="text-xs font-bold" id="toast-title">Item Added to Cart!</p>
                <p class="text-[11px] text-slate-300">Your basket has been updated.</p>
            </div>
            <a href="/cart" class="ml-2 text-xs font-bold text-indigo-400 hover:text-indigo-300 underline pointer-events-auto">
                View Cart →
            </a>
        </div>
    </div>

    <!-- Hero Header Banner -->
    <section class="relative overflow-hidden hero-gradient-canvas text-white -mt-16 pt-28 pb-20 sm:pb-24 lg:pt-36 lg:pb-28">
        <!-- Ambient Background Glows -->
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/4 right-1/4 w-[450px] h-[450px] bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/3 left-3/4 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Subtle Grid Pattern Overlay with bottom fade mask -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,#000_50%,transparent_85%)] pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div class="max-w-2xl">
                    <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 border border-indigo-400/20 px-3 py-1 rounded-full mb-3">
                        ⚡ Complete Catalog
                    </span>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
                        Explore Our Books
                    </h1>
                    <p class="text-slate-300 mt-3 text-sm sm:text-base">
                        Browse through <%= books ? books.length : 0 %> handpicked titles. Find your next favorite story and purchase with instant checkout.
                    </p>
                </div>

                <!-- Action: Search Bar & Total Books Counting Counter -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
                    <!-- Books Counter Showcase (Book Icon Removed, Big White Number) -->
                    <div class="relative group inline-flex items-center px-5 py-2 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-xl border border-white/20 shadow-xl shadow-indigo-950/40 transition duration-300">
                        <div class="flex items-center gap-3">
                            <!-- Big White Animated Number -->
                            <span 
                                id="animated-total-counter" 
                                data-target="<%= books ? books.length : 0 %>" 
                                class="text-4xl sm:text-5xl font-black text-white tabular-nums leading-none tracking-tight drop-shadow-md"
                            >0</span>
                            
                            <!-- Label Info -->
                            <div class="flex flex-col justify-center leading-tight border-l border-white/15 pl-3">
                                <span class="text-xs sm:text-sm font-extrabold text-slate-200 uppercase tracking-wider">Books</span>
                                <span class="text-[11px] text-slate-400 font-medium">In Catalog</span>
                            </div>
                        </div>
                    </div>

                    <!-- Search Bar with Search Button -->
                    <div class="relative flex items-center bg-white/10 backdrop-blur-lg border border-white/20 rounded-2xl p-1.5 shadow-2xl focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-400/40 transition w-full sm:w-80 lg:w-96">
                        <div class="pl-3 text-slate-400">
                            <svg class="w-4 h-4 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        <input 
                            type="text" 
                            id="hero-books-search-input" 
                            placeholder="Search books by title, author..." 
                            class="w-full bg-transparent px-3 py-1.5 text-white placeholder-slate-400 focus:outline-none text-xs sm:text-sm"
                        >
                        <button 
                            type="button" 
                            id="hero-books-search-btn"
                            class="shrink-0 bg-gradient-to-r from-indigo-500 to-blue-600 hover:from-indigo-600 hover:to-blue-700 text-white font-bold px-4 py-2 rounded-xl shadow-md transition transform active:scale-95 text-xs sm:text-sm flex items-center gap-1.5 cursor-pointer"
                        >
                            <span>Search</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Search & Filter Controls Bar -->
    <div class="bg-white border-b border-gray-200 sticky top-16 z-40 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                
                <!-- Live Search Box -->
                <div class="relative flex-1 max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <input 
                        type="text" 
                        id="books-search-input" 
                        placeholder="Search books by title, author, or category..." 
                        class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition"
                    >
                </div>

                <!-- Category Pills -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0" id="filter-pills">
                    <button type="button" data-filter="all" class="category-pill active-pill shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white shadow-xs">
                        All (<%= books ? books.length : 0 %>)
                    </button>
                    <button type="button" data-filter="self learning" class="category-pill shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-gray-100 text-gray-700 hover:bg-gray-200">
                        Self Learning
                    </button>
                    <button type="button" data-filter="fantasy" class="category-pill shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-gray-100 text-gray-700 hover:bg-gray-200">
                        Fantasy
                    </button>
                    <button type="button" data-filter="fiction" class="category-pill shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-gray-100 text-gray-700 hover:bg-gray-200">
                        Fiction
                    </button>
                    <button type="button" data-filter="technology" class="category-pill shrink-0 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-gray-100 text-gray-700 hover:bg-gray-200">
                        Technology
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Main Books Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Books Grid -->
        <% if (books && books.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="books-catalog-grid">
                <% books.forEach(book => { %>
                    <div class="book-card group bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col"
                         data-category="<%= (book.category || '').toLowerCase() %>"
                         data-title="<%= (book.name || book.title || '').toLowerCase() %>"
                         data-author="<%= (book.author || '').toLowerCase() %>">
                        
                        <!-- Book Cover Container -->
                        <div class="relative h-72 bg-gradient-to-b from-gray-50 to-gray-100 flex items-center justify-center p-5 overflow-hidden">
                            <a href="/books/edit/<%= book._id %>" class="h-full w-full flex items-center justify-center" title="Click to edit or view">
                                <img 
                                    src="/<%= book.image %>" 
                                    alt="<%= book.name || book.title || 'Book cover' %>"
                                    class="h-full w-auto max-w-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-300"
                                    onerror="this.src='/img1.png'"
                                    loading="lazy"
                                >
                            </a>

                            <!-- Category Badge -->
                            <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-indigo-700 text-[10px] font-extrabold px-2.5 py-1 rounded-lg border border-gray-100 shadow-xs">
                                <%= book.category || 'General' %>
                            </span>

                            <!-- Edit Quick Button -->
                            <a href="/books/edit/<%= book._id %>" 
                               class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-gray-600 hover:text-indigo-600 shadow-xs flex items-center justify-center transition" 
                               title="Edit Book Details">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                                </svg>
                            </a>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <!-- Author -->
                                <p class="text-xs font-semibold text-gray-400 mb-1 line-clamp-1">
                                    <%= book.author ? `by ${book.author}` : 'Bestselling Author' %>
                                </p>

                                <!-- Title -->
                                <h2 class="text-base font-bold text-gray-900 group-hover:text-indigo-600 transition-colors line-clamp-1">
                                    <%= book.name || book.title %>
                                </h2>

                                <!-- Rating & Stock -->
                                <div class="flex items-center justify-between mt-2">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-amber-400 text-xs">★★★★★</span>
                                        <span class="text-[11px] font-semibold text-gray-500">4.9</span>
                                    </div>
                                    <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">
                                        In Stock
                                    </span>
                                </div>
                            </div>

                            <!-- Price and Buy / Add to Cart Action Buttons -->
                            <div class="mt-4 pt-4 border-t border-gray-100">
                                <div class="flex items-baseline justify-between mb-3.5">
                                    <div>
                                        <span class="text-xl font-extrabold text-indigo-600">₹<%= book.price %></span>
                                        <span class="text-xs text-gray-400 line-through ml-1.5">₹<%= Math.round(Number(book.price || 0) * 1.25) %></span>
                                    </div>
                                    <span class="text-[10px] font-bold text-rose-600 uppercase tracking-wider">
                                        Save 20%
                                    </span>
                                </div>

                                <!-- Dual Action Buttons: BUY NOW & ADD TO CART -->
                                <div class="grid grid-cols-2 gap-2">
                                    
                                    <!-- Add to Cart Button -->
                                    <a href="/books/add-to-cart/<%= book._id %>" 
                                       class="add-to-cart-btn text-center py-2.5 px-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs transition flex items-center justify-center gap-1.5 active:scale-95"
                                       title="Add to Shopping Cart">
                                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                        </svg>
                                        <span>Add to Cart</span>
                                    </a>

                                    <!-- Buy Now Button -->
                                    <a href="/books/buy/<%= book._id %>" 
                                       class="text-center py-2.5 px-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-extrabold text-xs shadow-md shadow-amber-500/20 transition flex items-center justify-center gap-1.5 active:scale-95"
                                       title="Buy Now - Go straight to Cart & Checkout">
                                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                        </svg>
                                        <span>Buy Now</span>
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty state when no books found -->
            <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-gray-300 p-8">
                <div class="text-4xl mb-3">📚</div>
                <h3 class="text-xl font-bold text-gray-900">No books in catalog yet</h3>
                <p class="text-gray-500 text-sm mt-1 max-w-sm mx-auto">Get started by creating your first book or click below to seed sample books.</p>
                <div class="mt-6 flex items-center justify-center gap-3">
                    <button onclick="document.getElementById('open-add-book-modal').click()" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-xs font-bold shadow-md hover:bg-indigo-700 transition">
                        + Add First Book
                    </button>
                    <a href="/books" class="px-5 py-2.5 rounded-xl bg-gray-100 text-gray-700 text-xs font-semibold hover:bg-gray-200 transition">
                        Reload Catalog
                    </a>
                </div>
            </div>
        <% } %>

        <!-- Filter Empty State (Hidden by default) -->
        <div id="no-filtered-results" class="hidden text-center py-16 bg-white rounded-3xl border border-gray-200 mt-6 p-8">
            <div class="text-3xl mb-3">🔍</div>
            <h3 class="text-lg font-bold text-gray-900">No matching books found</h3>
            <p class="text-gray-500 text-xs mt-1">Try different search terms or clear your category filter.</p>
            <button id="reset-filter-btn" class="mt-4 px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-semibold hover:bg-indigo-700 transition">
                Reset All Filters
            </button>
        </div>

    </main>

    <!-- ============================================================== -->
    <!-- MODAL: ADD NEW BOOK                                            -->
    <!-- ============================================================== -->
    <div id="add-book-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-lg w-full overflow-hidden border border-gray-100 transform transition-all duration-300">
            
            <!-- Modal Header -->
            <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-indigo-900 text-white p-6 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold">Add Book to Catalog</h3>
                    <p class="text-xs text-indigo-200 mt-0.5">Fill out book details to publish in store</p>
                </div>
                <button type="button" id="close-modal-btn" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-sm font-bold transition">
                    ✕
                </button>
            </div>

            <!-- Modal Form -->
            <form action="/books/add" method="POST" class="p-6 space-y-4">
                
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1.5">Book Title / Name *</label>
                    <input 
                        type="text" 
                        name="name" 
                        placeholder="e.g. The Psychology of Money" 
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" 
                        required
                    >
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Author</label>
                        <input 
                            type="text" 
                            name="author" 
                            placeholder="e.g. Morgan Housel" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none"
                        >
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Price (₹) *</label>
                        <input 
                            type="number" 
                            name="price" 
                            placeholder="e.g. 450" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none" 
                            required
                        >
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Category</label>
                        <select 
                            name="category" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none bg-white"
                        >
                            <option value="Self learning">Self learning</option>
                            <option value="Fantasy">Fantasy</option>
                            <option value="Fiction">Fiction</option>
                            <option value="Technology">Technology</option>
                            <option value="Classic">Classic</option>
                            <option value="History">History</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Cover Image</label>
                        <select 
                            name="image" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none bg-white"
                        >
                            <option value="img1.png">Image 1 (img1.png)</option>
                            <option value="img2.jpg">Image 2 (img2.jpg)</option>
                            <option value="img3.png">Image 3 (img3.png)</option>
                            <option value="img4.png">Image 4 (img4.png)</option>
                            <option value="img5.png">Image 5 (img5.png)</option>
                            <option value="img6.png">Image 6 (img6.png)</option>
                            <option value="img7.png">Image 7 (img7.png)</option>
                            <option value="img8.png">Image 8 (img8.png)</option>
                            <option value="img9.png">Image 9 (img9.png)</option>
                            <option value="img10.png">Image 10 (img10.png)</option>
                            <option value="img11.png">Image 11 (img11.png)</option>
                            <option value="img12.png">Image 12 (img12.png)</option>
                        </select>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
                    <button type="button" id="cancel-modal-btn" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 text-xs font-bold hover:bg-gray-50 transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition">
                        Publish Book
                    </button>
                </div>

            </form>

        </div>
    </div>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

    <!-- Filter & Modal Interactions Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Check for toast notification in query params (?itemAdded=1 or ?added=1)
            const urlParams = new URLSearchParams(window.location.search);
            const toast = document.getElementById('toast-notification');
            const toastTitle = document.getElementById('toast-title');

            if (urlParams.has('itemAdded')) {
                toastTitle.textContent = "Book Added to Cart!";
                showToast();
            } else if (urlParams.has('added')) {
                toastTitle.textContent = "New Book Created!";
                showToast();
            }

            function showToast() {
                if (!toast) return;
                toast.classList.remove('translate-y-20', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
                setTimeout(() => {
                    toast.classList.remove('translate-y-0', 'opacity-100');
                    toast.classList.add('translate-y-20', 'opacity-0');
                }, 3500);
            }

            // Search & Category Filtering
            const searchInput = document.getElementById('books-search-input');
            const filterPills = document.querySelectorAll('.category-pill');
            const bookCards = document.querySelectorAll('.book-card');
            const noFilteredResults = document.getElementById('no-filtered-results');
            const resetFilterBtn = document.getElementById('reset-filter-btn');

            let currentCategory = 'all';
            let searchQuery = '';

            function applyFilters() {
                let matchCount = 0;
                bookCards.forEach(card => {
                    const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
                    const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
                    const cardAuthor = (card.getAttribute('data-author') || '').toLowerCase();

                    const matchesCat = currentCategory === 'all' || cardCat.includes(currentCategory);
                    const matchesSearch = !searchQuery || 
                                          cardTitle.includes(searchQuery) || 
                                          cardAuthor.includes(searchQuery) || 
                                          cardCat.includes(searchQuery);

                    if (matchesCat && matchesSearch) {
                        card.style.display = 'flex';
                        matchCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noFilteredResults) {
                    if (matchCount === 0 && bookCards.length > 0) {
                        noFilteredResults.classList.remove('hidden');
                    } else {
                        noFilteredResults.classList.add('hidden');
                    }
                }

                // Update counter on filter change
                if (typeof animateTotalCounter === 'function') {
                    animateTotalCounter(matchCount);
                }
            }

            // Counting animation transition (e.g. 1 2 3 4 5 6 7 8 9 ... total)
            const counterEl = document.getElementById('animated-total-counter');
            let counterInterval = null;

            function animateTotalCounter(targetValue) {
                if (!counterEl) return;
                if (counterInterval) clearInterval(counterInterval);

                const finalCount = parseInt(targetValue, 10) || 0;
                if (finalCount === 0) {
                    counterEl.textContent = '0';
                    return;
                }

                let current = 0;
                const duration = Math.min(1200, Math.max(300, finalCount * 65));
                const stepTime = Math.max(30, Math.floor(duration / finalCount));

                counterInterval = setInterval(() => {
                    current++;
                    counterEl.textContent = current;
                    if (current >= finalCount) {
                        clearInterval(counterInterval);
                    }
                }, stepTime);
            }

            if (counterEl) {
                const initialTarget = counterEl.getAttribute('data-target') || '0';
                animateTotalCounter(initialTarget);
            }

            // Connect Hero Search Input & Button
            const heroSearchInput = document.getElementById('hero-books-search-input');
            const heroSearchBtn = document.getElementById('hero-books-search-btn');

            if (heroSearchInput) {
                heroSearchInput.addEventListener('input', (e) => {
                    searchQuery = e.target.value.trim().toLowerCase();
                    if (searchInput && searchInput !== heroSearchInput) {
                        searchInput.value = e.target.value;
                    }
                    applyFilters();
                });
                heroSearchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const gridEl = document.getElementById('books-catalog-grid') || document.querySelector('main');
                        if (gridEl) gridEl.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            }

            if (heroSearchBtn) {
                heroSearchBtn.addEventListener('click', () => {
                    applyFilters();
                    const gridEl = document.getElementById('books-catalog-grid') || document.querySelector('main');
                    if (gridEl) gridEl.scrollIntoView({ behavior: 'smooth' });
                });
            }

            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    searchQuery = e.target.value.trim().toLowerCase();
                    if (heroSearchInput && heroSearchInput !== searchInput) {
                        heroSearchInput.value = e.target.value;
                    }
                    applyFilters();
                });
            }

            filterPills.forEach(pill => {
                pill.addEventListener('click', () => {
                    filterPills.forEach(p => {
                        p.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
                        p.classList.add('bg-gray-100', 'text-gray-700');
                    });
                    pill.classList.remove('bg-gray-100', 'text-gray-700');
                    pill.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');

                    currentCategory = pill.getAttribute('data-filter') || 'all';
                    applyFilters();
                });
            });

            if (resetFilterBtn) {
                resetFilterBtn.addEventListener('click', () => {
                    if (searchInput) searchInput.value = '';
                    if (heroSearchInput) heroSearchInput.value = '';
                    searchQuery = '';
                    currentCategory = 'all';
                    filterPills.forEach((p, idx) => {
                        if (idx === 0) {
                            p.classList.add('bg-indigo-600', 'text-white', 'shadow-xs');
                            p.classList.remove('bg-gray-100', 'text-gray-700');
                        } else {
                            p.classList.remove('bg-indigo-600', 'text-white', 'shadow-xs');
                            p.classList.add('bg-gray-100', 'text-gray-700');
                        }
                    });
                    applyFilters();
                });
            }

            // Modal Controls
            const modal = document.getElementById('add-book-modal');
            const openModalBtn = document.getElementById('open-add-book-modal');
            const closeModalBtn = document.getElementById('close-modal-btn');
            const cancelModalBtn = document.getElementById('cancel-modal-btn');

            if (openModalBtn && modal) {
                openModalBtn.addEventListener('click', () => {
                    modal.classList.remove('hidden');
                });
            }

            const hideModal = () => {
                if (modal) modal.classList.add('hidden');
            };

            if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
            if (cancelModalBtn) cancelModalBtn.addEventListener('click', hideModal);

            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) hideModal();
                });
            }
        });
    </script>

</body>
</html>