<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - BookStore</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Seamless Hero Dark Navy to Pure White Gradient */
        .hero-gradient-canvas {
            background-color: #171936;
            background-image: 
                radial-gradient(ellipse 70% 55% at 75% 25%, rgba(147, 51, 234, 0.22) 0%, transparent 70%),
                radial-gradient(ellipse 60% 45% at 20% 15%, rgba(99, 102, 241, 0.20) 0%, transparent 65%),
                linear-gradient(
                    180deg,
                    #171936 0%,
                    #171936 46%,
                    #1a1e43 58%,
                    #212756 68%,
                    #2d356f 77%,
                    #444f8e 84%,
                    #6976b0 89.5%,
                    #9aa6d3 93.5%,
                    #ccd3ee 96.5%,
                    #f3f5fb 98.8%,
                    #ffffff 100%
                );
        }
    </style>
</head>
<body class="bg-white text-gray-900 antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header Navigation -->
    <%- include('includes/nav.ejs') %>

    <!-- Hero Header Banner with Seamless Dark Navy to White Gradient -->
    <section class="relative overflow-hidden hero-gradient-canvas text-white -mt-16 pt-28 pb-20 sm:pb-24 lg:pt-36 lg:pb-28">
        <!-- Ambient Background Glows -->
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/4 right-1/4 w-[450px] h-[450px] bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/3 left-3/4 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Subtle Grid Pattern Overlay with bottom fade mask -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:linear-gradient(to_bottom,#000_50%,transparent_85%)] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 border border-indigo-400/20 px-3 py-1 rounded-full mb-3">
                📖 Our Story & Mission
            </span>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
                About Our Bookstore
            </h1>
            <p class="text-slate-300 mt-3 text-sm sm:text-base max-w-xl mx-auto">
                A place where books inspire learning, spark curiosity, and empower personal transformation.
            </p>
        </div>
    </section>

    <!-- Main Content Section on Pure White -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-white">
        
        <!-- Main Feature Card -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden mb-14">
            <div class="grid md:grid-cols-2">
                
                <!-- Left Story Column -->
                <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-10 md:p-14 flex flex-col justify-center">
                    <p class="text-indigo-300 uppercase tracking-widest text-xs font-extrabold mb-3">
                        Our Genesis
                    </p>
                    <h2 class="text-3xl md:text-4xl font-extrabold mb-5 leading-tight">
                        Books Open the Door to New Ideas
                    </h2>
                    <p class="text-slate-300 leading-relaxed text-base">
                        Our bookstore was founded with a singular purpose: connecting passionate readers, curious minds, and dedicated students with handpicked literary masterworks from around the world.
                    </p>
                    <div class="mt-8 pt-8 border-t border-white/10 grid grid-cols-2 gap-4">
                        <div>
                            <div class="text-2xl font-black text-amber-300">10,000+</div>
                            <div class="text-xs text-slate-400 mt-0.5">Curated Volumes</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-emerald-400">100%</div>
                            <div class="text-xs text-slate-400 mt-0.5">Original Prints</div>
                        </div>
                    </div>
                </div>

                <!-- Right Values Column -->
                <div class="p-8 md:p-12 flex flex-col justify-center bg-gray-50/60">
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">
                        Why Choose BookStore?
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-6">
                        We believe that holding a physical book offers an irreplaceable sensory and intellectual experience. That is why we obsess over print authenticity, fast dispatch, and reader satisfaction.
                    </p>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="bg-white p-4 rounded-2xl border border-gray-200/70 shadow-xs">
                            <span class="text-2xl">📚</span>
                            <h4 class="font-bold text-gray-900 text-sm mt-2">Curated Catalog</h4>
                            <p class="text-xs text-gray-500 mt-1">From international bestsellers to rare technical guides.</p>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-gray-200/70 shadow-xs">
                            <span class="text-2xl">⚡</span>
                            <h4 class="font-bold text-gray-900 text-sm mt-2">Express Delivery</h4>
                            <p class="text-xs text-gray-500 mt-1">Carefully packaged and dispatched within 24 hours.</p>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-gray-200/70 shadow-xs">
                            <span class="text-2xl">🛡️</span>
                            <h4 class="font-bold text-gray-900 text-sm mt-2">100% Authentic</h4>
                            <p class="text-xs text-gray-500 mt-1">Direct from verified publishers and distributors.</p>
                        </div>
                        <div class="bg-white p-4 rounded-2xl border border-gray-200/70 shadow-xs">
                            <span class="text-2xl">💬</span>
                            <h4 class="font-bold text-gray-900 text-sm mt-2">Reader Support</h4>
                            <p class="text-xs text-gray-500 mt-1">Friendly book lovers ready to answer your questions.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <!-- Footer -->
    <%- include('includes/footer.ejs') %>

</body>
</html>