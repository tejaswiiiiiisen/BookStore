<nav id="glass-nav" class="sticky top-0 z-50 transition-all duration-300 border-b border-white/10" style="background: rgba(23, 25, 54, 0.25); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-indigo-600 to-blue-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform duration-200 border border-white/20">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </div>
                <span class="text-xl font-extrabold bg-gradient-to-r from-white via-indigo-100 to-indigo-300 bg-clip-text text-transparent">
                    BookStore
                </span>
            </a>

            <!-- Nav Links -->
            <div class="hidden md:flex items-center gap-1 font-semibold text-sm text-slate-200">
                <a href="/" class="px-3.5 py-2 rounded-xl hover:text-white hover:bg-white/10 transition">Home</a>
                <a href="/books" class="px-3.5 py-2 rounded-xl hover:text-white hover:bg-white/10 transition">Books</a>
                <a href="/category" class="px-3.5 py-2 rounded-xl hover:text-white hover:bg-white/10 transition">Categories</a>
                <a href="/about" class="px-3.5 py-2 rounded-xl hover:text-white hover:bg-white/10 transition">About</a>
                <a href="/contact" class="px-3.5 py-2 rounded-xl hover:text-white hover:bg-white/10 transition">Contact</a>
            </div>

            <!-- Cart & Actions -->
            <div class="flex items-center gap-3">
                <a href="/cart" class="relative flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold border border-white/15 backdrop-blur-md shadow-xs transition group">
                    <svg class="w-5 h-5 text-indigo-300 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <span class="hidden sm:inline">Cart</span>
                    <% 
                        const totalCartCount = (typeof cart !== 'undefined' && Array.isArray(cart)) 
                            ? cart.reduce((sum, item) => sum + (Number(item.quantity) || 1), 0) 
                            : 0;
                    %>
                    <% if (totalCartCount > 0) { %>
                        <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-black leading-none text-white bg-indigo-500 rounded-full shadow-sm animate-pulse">
                            <%= totalCartCount %>
                        </span>
                    <% } %>
                </a>
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Subbar -->
    <div class="md:hidden flex items-center justify-around border-t border-white/10 py-2.5 px-3 bg-[#171936]/60 backdrop-blur-xl text-xs font-semibold text-slate-200">
        <a href="/" class="hover:text-white py-1">Home</a>
        <a href="/books" class="hover:text-white py-1">Books</a>
        <a href="/category" class="hover:text-white py-1">Categories</a>
        <a href="/about" class="hover:text-white py-1">About</a>
        <a href="/contact" class="hover:text-white py-1">Contact</a>
    </div>
</nav>

<script>
    (function() {
        const nav = document.getElementById('glass-nav');
        if (!nav) return;
        function updateNavGlass() {
            if (window.scrollY > 25) {
                nav.style.background = 'rgba(23, 25, 54, 0.75)';
                nav.style.borderColor = 'rgba(255, 255, 255, 0.12)';
                nav.style.boxShadow = '0 10px 30px -10px rgba(0, 0, 0, 0.4)';
            } else {
                nav.style.background = 'rgba(23, 25, 54, 0.25)';
                nav.style.borderColor = 'rgba(255, 255, 255, 0.08)';
                nav.style.boxShadow = 'none';
            }
        }
        window.addEventListener('scroll', updateNavGlass, { passive: true });
        updateNavGlass();
    })();
</script>